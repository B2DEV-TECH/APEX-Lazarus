list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry employees (
        label: Employees
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

)

