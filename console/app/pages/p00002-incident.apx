            }
        )
        column USER_COLOR (
            type: plainText
            heading {
                heading: Color
            }
            layout {
                sequence: 30
            }
        )
        column EVENT_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 40
            }
        )
        column EVENT_TYPE (
            type: plainText
            heading {
                heading: Transition
            }
            layout {
                sequence: 50
            }
        )
        column EVENT_TITLE (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
        )
        column EVENT_DESC (
            type: plainText
