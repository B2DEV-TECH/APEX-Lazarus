    region evidence (
        name: Evidence
        type: dynamicContent
        layout {
            sequence: 50
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
        source {
            language: plsql
            plsqlFunctionBody: ```plsql
declare
    v_evidence clob;
begin
    for r in (
        select json_serialize(p.evidence returning clob pretty) as evidence
          from lz_patch p
          join lz_attempt a on a.attempt_id = p.attempt_id
         where a.incident_id = :P2_INCIDENT_ID
         order by a.attempt_no desc
         fetch first 1 row only
    ) loop
        v_evidence := r.evidence;
    end loop;

    if v_evidence is null then
        return '<p class="lz-muted">No evidence yet.</p>';
    end if;
    -- APEX_ESCAPE.HTML takes a VARCHAR2; evidence documents stay well below that
    return '<pre class="lz-json">' || apex_escape.html(dbms_lob.substr(v_evidence, 30000, 1)) || '</pre>';
end;
```
        }
    )

    pageItem P2_INCIDENT_ID (
        type: hidden
        layout {
            sequence: 1
            region: @summary
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

)
